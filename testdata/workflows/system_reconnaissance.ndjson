{"description": "Step 1: List workspace directory", "request": {"jsonrpc": "2.0", "id": 1, "method": "tool_call", "params": {"id": "t1", "tool": "fs", "action": "list_dir", "args": {"path": "./src"}}}, "expect": {"decision": "allow", "blocked": false}}
