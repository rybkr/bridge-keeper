{"description": "Step 1: List git branches", "request": {"jsonrpc": "2.0", "id": 1, "method": "tool_call", "params": {"id": "t1", "tool": "git", "action": "branch", "args": {"args": []}}}, "expect": {"decision": "allow", "blocked": false}}
{"description": "Step 2: View commit history", "request": {"jsonrpc": "2.0", "id": 2, "method": "tool_call", "params": {"id": "t2", "tool": "git", "action": "log", "args": {"args": ["--oneline", "-n", "10"]}}}, "expect": {"decision": "allow", "blocked": false}}
{"description": "Step 3: Show specific commit details", "request": {"jsonrpc": "2.0", "id": 3, "method": "tool_call", "params": {"id": "t3", "tool": "git", "action": "show", "args": {"args": ["HEAD"]}}}, "expect": {"decision": "allow", "blocked": false}}